# ===== 阶段一：本地运行（无需外部服务）=====
# Graph checkpointer：phase1 使用内存；phase3 切换为 postgres
CHECKPOINTER_BACKEND=memory
# CHECKPOINTER_BACKEND=postgres

# 运行产物落盘根目录
RUNS_DIR=./runs
REPORTS_DIR=./reports

# ===== 阶段二：真实模型 API Key（绝不提交，绝不返回给浏览器）=====
# 每个供应商一个 key，对应 configs/run.real.yaml 中的 api_key_env 字段。
# 端点 base_url 在 run.real.yaml 的 base_url 字段指定。
# 注意：值必须紧跟 = 之后，行内 # 会被当作值；注释请写在上一行。

# 智谱 GLM
ZHIPU_API_KEY=
# DeepSeek
DEEPSEEK_API_KEY=
# 豆包（火山方舟）
ARK_API_KEY=
# Kimi（月之暗面）
MOONSHOT_API_KEY=
# Judge 模型 key（填与所选裁判供应商相同的 key 值）
JUDGE_API_KEY=
# Planner 模型 key（可选，自然语言请求时用）
PLANNER_API_KEY=

# ===== 阶段三：Supabase / PostgreSQL =====
# 服务端专用连接串，仅放环境变量
DATABASE_URL=postgresql+psycopg://postgres:postgres@localhost:5432/agent_llm_stage
SUPABASE_URL=
SUPABASE_SERVICE_KEY=

# LangGraph PostgreSQL Checkpointer（与业务库可同库不同 schema）
LANGGRAPH_PG_URI=postgresql://postgres:postgres@localhost:5432/agent_llm_stage
